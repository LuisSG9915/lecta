{
  "name": "@lecta/mcp",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "description": "Servidor MCP local para consultar Lecta desde agentes de IA",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "tsx": "4.20.6",
    "typescript": "6.0.3"
  }
}
