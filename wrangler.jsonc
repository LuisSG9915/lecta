{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "lecta",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2026-10-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"secrets": {
		"required": [
			"DATABASE_URL",
			"DEEPSEEK_API_KEY",
			"BETTER_AUTH_SECRET",
			"RESEND_API_KEY",
			"RESEND_FROM_EMAIL",
			"AI_GATEWAY_KEY",
			"AI_GATEWAY_URL",
			"STRIPE_SECRET_KEY",
			"STRIPE_WEBHOOK_SECRET",
			"STRIPE_PRICE_MONTHLY_ID",
			"STRIPE_PRICE_YEARLY_ID"
		]
	},
	// Dominio canónico lectal.app. workers.dev sigue activo solo para servir el
	// 301 de las páginas y la API (webhook de Stripe, MCP): ver
	// src/worker/canonical-host.ts.
	"routes": [
		{
			"pattern": "lectal.app",
			"custom_domain": true
		}
	],
	"workers_dev": true,
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		// Todo pasa por el Worker (para redirigir el host viejo) salvo los
		// directorios de archivos estáticos, que van directo a los assets.
		"run_worker_first": [
			"/*",
			"!/assets/*",
			"!/audio/*",
			"!/dict/*",
			"!/fonts/*",
			"!/icons/*",
			"!/lexicon/*",
			"!/libros/*",
			"!/inicio/web/*",
			"!/inicio/fonts/*"
		]
	},
	"r2_buckets": [
		{
			"binding": "BOOKS",
			"bucket_name": "lecta-books"
		}
	],
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "0b4288d943744e1ca438deb90ac235e9"
		},
		{
			"binding": "HYPERDRIVE_CACHED",
			"id": "7d2a49ff519844f9b53b804ba93e21aa"
		}
	],
	"workflows": [
		{
			"name": "lecta-enrichment",
			"binding": "ENRICHMENT_WORKFLOW",
			"class_name": "EnrichmentWorkflow"
		}
	],
	"triggers": {
		"crons": [
			"0 5 * * *"
		]
	},
	"placement": {
		"mode": "smart"
	},
	"observability": {
		"logs": {
			"enabled": true
		},
		"issues": {
			"enabled": true
		}
	}
}