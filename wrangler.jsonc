{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "lecta",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2026-10-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"secrets": {
		"required": [
			"DATABASE_URL",
			"DEEPSEEK_API_KEY",
			"BETTER_AUTH_SECRET",
			"RESEND_API_KEY",
			"RESEND_FROM_EMAIL",
			"AI_GATEWAY_KEY",
			"AI_GATEWAY_URL"
		]
	},
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/k",
			"/k/*",
			"/kindle",
			"/kindle/*"
		]
	},
	"r2_buckets": [
		{
			"binding": "BOOKS",
			"bucket_name": "lecta-books"
		}
	],
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "0b4288d943744e1ca438deb90ac235e9"
		}
	],
	"workflows": [
		{
			"name": "lecta-enrichment",
			"binding": "ENRICHMENT_WORKFLOW",
			"class_name": "EnrichmentWorkflow"
		}
	],
	"triggers": {
		"crons": [
			"0 5 * * *"
		]
	},
	"assets__added": {},
	"placement": {
		"mode": "smart"
	},
	"observability": {
		"issues": {
			"enabled": true
		},
		"issues__deleted": {}
	}
}