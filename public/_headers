/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ws: wss: https://huggingface.co https://*.huggingface.co https://hf.co https://*.hf.co https://*.cdn.hf.co https://*.aws.cdn.hf.co https://*.xethub.hf.co https://*.cas.hf.co https://*.cloudfront.net https://*.amazonaws.com https://cdn.jsdelivr.net https://*.jsdelivr.net; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/sw-manifest.json
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate

# Modelos ONNX de Kitten TTS (DLC Offline): exponer Content-Length para barra de progreso 0-100%
/models/*
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Expose-Headers: Content-Length, Content-Range
  Accept-Ranges: bytes

/*.onnx
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Expose-Headers: Content-Length, Content-Range
  Accept-Ranges: bytes

# Binarios WebAssembly (ONNX Runtime / Foliate)
/assets/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Expose-Headers: Content-Length, Content-Range
  Accept-Ranges: bytes

/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Expose-Headers: Content-Length, Content-Range
  Accept-Ranges: bytes

# Fuentes tipográficas de lectura (Literata, Alegreya, Atkinson, OpenDyslexic, Source Serif)
/assets/*.woff2
  Content-Type: font/woff2
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/libros/*
  Cache-Control: public, max-age=86400

# Tablas léxicas descargables (Fase 8): se sirven como archivo, no como texto.
# Van antes de /lexicon/* para que mande la regla específica.
/lexicon/forms-es.tsv.gz
  Content-Type: application/gzip
  Content-Disposition: attachment; filename="forms-es.tsv.gz"

/lexicon/lemmas-freq-es.tsv.gz
  Content-Type: application/gzip
  Content-Disposition: attachment; filename="lemmas-freq-es.tsv.gz"

/lexicon/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/icons/*
  Cache-Control: public, max-age=86400

# Audios del compañero gato y efectos sonoros
/audio/*
  Cache-Control: public, max-age=31536000, immutable
