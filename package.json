{
  "name": "lecta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.worker.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:setup": "node --env-file=.env scripts/db-setup.mjs",
    "db:auth": "node --env-file=.env scripts/auth-migrate.mjs",
    "db:migrate": "node --env-file=.env scripts/db-migrate.mjs",
    "smoke:auth": "node scripts/smoke-auth.mjs"
  },
  "dependencies": {
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource/alegreya-sans": "5.3.0",
    "@zip.js/zip.js": "2.18.2",
    "better-auth": "1.7.6",
    "dompurify": "3.4.16",
    "foliate-js": "1.0.1",
    "hono": "4.13.9",
    "idb": "8.0.3",
    "kysely": "0.29.6",
    "onnxruntime-web": "1.30.0",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.60.2",
    "@cloudflare/workers-types": "5.20260925.2",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/opendyslexic": "5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wrangler": "4.141.0"
  }
}
