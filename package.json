{
  "name": "lecta",
  "version": "0.2.13",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "preview:local": "LECTA_KEEP_DEV_VARS=1 vite build && vite preview",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.worker.json && pnpm mcp:typecheck",
    "lint": "eslint . --max-warnings 0",
    "check:size": "node scripts/check-bundle-budget.mjs",
    "gate": "pnpm typecheck && pnpm lint && node scripts/test-trace.mjs && pnpm run build && pnpm run check:size",
    "gate": "pnpm typecheck && pnpm lint && node scripts/test-trace.mjs && pnpm run build && pnpm run check:size",
    "symbols": "node --env-file=.env scripts/symbolicate.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage:ratchet": "vitest run --coverage.thresholds.autoUpdate=true",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "db:setup": "node --env-file=.env scripts/db-setup.mjs",
    "db:auth": "node --env-file=.env scripts/auth-migrate.mjs",
    "db:migrate": "node --env-file=.env scripts/db-migrate.mjs",
    "smoke:auth": "node scripts/smoke-auth.mjs",
    "smoke:sync": "node scripts/smoke-sync.mjs",
    "measure:open": "node scripts/measure-open-latency.mjs",
    "audit:investigacion": "node scripts/audit-investigacion.mjs",
    "audit:investigacion:online": "node scripts/audit-investigacion.mjs --online",
    "audit:cuaderno": "node scripts/audit-cuaderno.mjs",
    "audit:cuaderno:online": "node scripts/audit-cuaderno.mjs --online",
    "audit:cuaderno:brief": "node scripts/audit-cuaderno.mjs --brief",
    "gemini": "node scripts/pack-gemini.mjs",
    "gemini:clip": "node scripts/pack-gemini.mjs --clipboard",
    "model:upload": "node scripts/upload-model.mjs",
    "mcp": "pnpm --filter @lecta/mcp dev",
    "mcp:build": "pnpm --filter @lecta/mcp build",
    "mcp:typecheck": "pnpm --filter @lecta/mcp typecheck"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.18.2",
    "better-auth": "1.7.6",
    "dompurify": "3.4.16",
    "foliate-js": "1.0.1",
    "hono": "4.13.9",
    "idb": "8.0.3",
    "kysely": "0.29.6",
    "onnxruntime-web": "1.30.0",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vite-plugin": "1.60.2",
    "@cloudflare/workers-types": "5.20260925.2",
    "@eslint/js": "10.0.1",
    "@jridgewell/trace-mapping": "0.3.31",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wrangler": "4.141.0"
  }
}
